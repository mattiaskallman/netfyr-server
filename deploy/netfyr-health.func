#!/usr/bin/env bash
# Bounded post-restart health probe shared by fresh installs and updates.
# Intended to be sourced by install-package.sh and by behavior tests.

netfyr_wait_for_health() {
  local configure_caddy=${1:?configure_caddy is required}
  local netfyr_ip=${2:?netfyr_ip is required}
  local attempts=${NETFYR_HEALTH_ATTEMPTS:-20}
  local attempt

  [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || return 2

  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if curl --connect-timeout 2 --max-time 3 -fsS \
      http://127.0.0.1:8080/api/health >/dev/null &&
      { [[ "$configure_caddy" != 1 ]] ||
        curl --connect-timeout 2 --max-time 3 -kfsS \
          "https://${netfyr_ip}/api/health" >/dev/null; }; then
      return 0
    fi
    if ((attempt < attempts)); then
      sleep 1
    fi
  done

  return 1
}
