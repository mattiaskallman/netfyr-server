#!/usr/bin/env bash
# Trusted release downloader shared by the LXC installer and updater.
# shellcheck shell=bash

NETFYR_RELEASE_REPO="mattiaskallman/netfyr-server"

_netfyr_download() {
  local url=$1 destination=$2
  curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 \
    --connect-timeout 15 --max-time 300 \
    --retry 3 --retry-all-errors \
    --user-agent 'NetFyr-LXC/1.0' \
    "$url" -o "$destination"
}

_netfyr_fetch_release_impl() (
  set -euo pipefail
  local target=${1:?target directory required}
  local requested=${2:-latest}
  local api tmp json tag version arch filename checksum_url asset_url expected root member

  command -v curl >/dev/null || { echo "curl is required" >&2; return 1; }
  command -v jq >/dev/null || { echo "jq is required" >&2; return 1; }
  command -v sha256sum >/dev/null || { echo "sha256sum is required" >&2; return 1; }
  command -v tar >/dev/null || { echo "tar is required" >&2; return 1; }
  [[ ! -e "$target" ]] || { echo "Release target already exists: $target" >&2; return 1; }

  case "$(dpkg --print-architecture 2>/dev/null || uname -m)" in
    amd64|x86_64) arch=amd64 ;;
    arm64|aarch64) arch=arm64 ;;
    *) echo "Unsupported architecture" >&2; return 1 ;;
  esac

  if [[ "$requested" == latest ]]; then
    api="https://api.github.com/repos/${NETFYR_RELEASE_REPO}/releases/latest"
  elif [[ "$requested" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]]; then
    api="https://api.github.com/repos/${NETFYR_RELEASE_REPO}/releases/tags/${requested}"
  else
    echo "Invalid NetFyr release tag: $requested" >&2
    return 1
  fi

  tmp=$(mktemp -d) || return 1
  trap 'rm -rf "$tmp"' EXIT
  json="$tmp/release.json"
  _netfyr_download "$api" "$json" || return 1

  tag=$(jq -er '.tag_name' "$json") || return 1
  [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]] || {
    echo "Invalid release tag returned by GitHub: $tag" >&2
    return 1
  }
  version=${tag#v}
  filename="netfyr-server-${tag}-linux-${arch}.tar.gz"

  asset_url=$(jq -er --arg name "$filename" '.assets[] | select(.name == $name) | .browser_download_url' "$json") || return 1
  checksum_url=$(jq -er '.assets[] | select(.name == "SHA256SUMS") | .browser_download_url' "$json") || return 1
  _netfyr_download "$asset_url" "$tmp/$filename" || return 1
  _netfyr_download "$checksum_url" "$tmp/SHA256SUMS" || return 1

  expected=$(awk -v file="$filename" '$2 == file {print $1}' "$tmp/SHA256SUMS") || return 1
  [[ "$expected" =~ ^[0-9a-fA-F]{64}$ ]] || {
    echo "No valid checksum for $filename" >&2
    return 1
  }
  if ! printf '%s  %s\n' "$expected" "$tmp/$filename" | sha256sum -c - >/dev/null; then
    echo "Checksum verification failed for $filename" >&2
    return 1
  fi

  root="netfyr-server-${tag}-linux-${arch}"
  if ! tar -tzf "$tmp/$filename" >"$tmp/members"; then
    echo "Could not list release archive" >&2
    return 1
  fi
  while IFS= read -r member; do
    [[ "$member" == "$root" || "$member" == "$root/"* ]] || {
      echo "Unexpected archive member: $member" >&2
      return 1
    }
    [[ "$member" != /* && "$member" != *'/../'* && "$member" != '../'* ]] || {
      echo "Unsafe archive member: $member" >&2
      return 1
    }
  done <"$tmp/members"

  if ! tar -tvzf "$tmp/$filename" >"$tmp/verbose-members"; then
    echo "Could not inspect release archive member types" >&2
    return 1
  fi
  while IFS= read -r member; do
    case "${member:0:1}" in
      -|d) ;;
      *)
        echo "Release archive contains a non-file/non-directory member" >&2
        return 1
        ;;
    esac
  done <"$tmp/verbose-members"

  mkdir "$tmp/unpack" || return 1
  if ! tar -xzf "$tmp/$filename" -C "$tmp/unpack" --no-same-owner --no-same-permissions; then
    echo "Could not extract release archive" >&2
    return 1
  fi
  [[ -x "$tmp/unpack/$root/bin/netfyr-server" ]] || { echo "Release binary missing" >&2; return 1; }
  [[ -f "$tmp/unpack/$root/web/index.html" ]] || { echo "Web interface missing" >&2; return 1; }
  [[ -x "$tmp/unpack/$root/deploy/install-package.sh" ]] || { echo "Package installer missing" >&2; return 1; }
  [[ -f "$tmp/unpack/$root/deploy/netfyr-release.func" ]] || { echo "Release helper missing" >&2; return 1; }
  [[ "$(<"$tmp/unpack/$root/VERSION")" == "$version" ]] || { echo "Version file mismatch" >&2; return 1; }

  mkdir -p "$(dirname "$target")" || return 1
  mv "$tmp/unpack/$root" "$target" || return 1
)

netfyr_fetch_release() {
  local target=${1:?target directory required}
  local requested=${2:-latest}
  local version arch
  if ! _netfyr_fetch_release_impl "$target" "$requested"; then
    return 1
  fi
  version=$(<"$target/VERSION")
  case "$(dpkg --print-architecture 2>/dev/null || uname -m)" in
    amd64|x86_64) arch=amd64 ;;
    arm64|aarch64) arch=arm64 ;;
    *) echo "Unsupported architecture" >&2; return 1 ;;
  esac
  NETFYR_FETCHED_VERSION=$version
  NETFYR_FETCHED_TAG="v${version}"
  NETFYR_FETCHED_ARCH=$arch
  export NETFYR_FETCHED_VERSION NETFYR_FETCHED_TAG NETFYR_FETCHED_ARCH
}
